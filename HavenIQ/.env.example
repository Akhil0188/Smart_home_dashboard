# Copy this file to ".env" and edit the values. Lines starting with # are comments.
# Write Windows paths exactly as they are (single backslashes, no quotes).

# --- Database (your existing SQLite file, opened READ-ONLY by the dashboard) ---
DB_PATH=C:\Users\YourName\Desktop\SmartHomeMQTT\smarthome.db

# Value stored in the `door` column when the door is OPEN (1 = open, 0 = closed).
DOOR_OPEN_VALUE=1

# Your sensor_data.timestamp uses DEFAULT CURRENT_TIMESTAMP, which SQLite stores in UTC.
# Keep this true (set false only if your writer stores local time).
TIMESTAMP_IS_UTC=true

# --- MQTT (used ONLY to show the real broker connection status) ---
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=home/sensors

# --- Device control (Light / Fan / AC) ---
# The dashboard PUBLISHES commands here:   {"device": "light", "state": "ON"}
MQTT_DEVICE_COMMAND_TOPIC=home/devices/commands
# The device (simulator or ESP32) PUBLISHES its real state here:   {"light": "ON", "fan": "OFF", "ac": "OFF"}
MQTT_DEVICE_STATUS_TOPIC=home/devices/status
# Seconds to wait for the device to confirm a command.
DEVICE_COMMAND_TIMEOUT_SECONDS=8
# Seconds without any device status before it is shown as "no recent update".
DEVICE_STATUS_STALE_SECONDS=120

# --- Dashboard behaviour ---
HOST=127.0.0.1
PORT=5000
REFRESH_SECONDS=3
HISTORY_POINTS=60
# Sensor data older than this many seconds is shown as "Stale".
STALE_AFTER_SECONDS=30
